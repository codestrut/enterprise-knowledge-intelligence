# Unified EKIP runtime: reuse the Task 05.3 dependency image and its cached packages.
FROM ekip-api:task05.3-isolation

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    EKIP_TENANT_DATA_DIRECTORY=/app/data/tenants \
    HF_HOME=/models \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Fail the build if the chosen base image is missing a required runtime package.
# Deliberately do not run pip: the Task 05.3 image is the dependency baseline.
RUN python -c "import fastapi, uvicorn, multipart, sqlalchemy, alembic, argon2, psycopg, pydantic, numpy, openai, pypdf, dotenv, rank_bm25, faiss, sentence_transformers, torch"

# Create a dedicated non-root runtime identity and grant it access only to the
# tenant data directory. The Hugging Face cache is mounted read-only at runtime.
RUN groupadd --gid 10001 ekip \
    && useradd --uid 10001 --gid ekip --create-home --shell /usr/sbin/nologin ekip \
    && mkdir -p /app/data/tenants /models \
    && chown 10001:10001 /app/data/tenants

COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
COPY frontend/dist-unified ./frontend/dist

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s \
    --timeout=5s \
    --start-period=180s \
    --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"]

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
