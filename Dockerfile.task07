FROM ekip-api:task05.3-isolation

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Remove inherited application code and runtime data.
# Retain the installed Python dependencies.
RUN rm -rf \
    /app/src \
    /app/migrations \
    /app/alembic.ini \
    /app/pytest.ini \
    /app/data \
    /app/.env \
    /app/.env.* \
    && groupadd --gid 10001 ekip \
    && useradd --uid 10001 --gid ekip \
        --create-home --shell /usr/sbin/nologin ekip \
    && mkdir -p /app/data/tenants /app/data/uploads /models \
    && chown -R 10001:10001 /app/data

# Copy the current repository implementation.
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
COPY pytest.ini .

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s \
    --timeout=5s \
    --start-period=180s \
    --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"]

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
